<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ministry Registry System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
</head>

<body>

    <div id="layout-root">

        <div class="mobile-overlay" id="mobileOverlay"></div>

        <nav id="sidebar">
            <div class="sidebar-header">

                <button id="sidebarToggle" class="btn btn-sm btn-light">
                    <i class="fas fa-chevron-left"></i>
                </button>
            </div>

            <div class="nav flex-column">
                <div class="nav-section-header">Main</div>
                <a class="nav-link" asp-page="/Dashboard/Index"><i
                        class="fas fa-chart-line"></i><span>Dashboard</span></a>

                <div class="nav-section-header">Registry</div>
                <a class="nav-link" asp-page="/Staff/Index"><i class="fas fa-users"></i><span>Staff</span></a>
                <a class="nav-link" asp-page="/Department/Index"><i
                        class="fas fa-building"></i><span>Departments</span></a>
                <a class="nav-link" asp-page="/File/Index"><i class="fas fa-folder-open"></i><span>Files</span></a>

                <div class="nav-section-header">Documents</div>
                <a class="nav-link" asp-page="/Document/Index"><i class="fas fa-file-alt"></i><span>Documents</span></a>
                <a class="nav-link" asp-page="/DocumentType/Index"><i class="fas fa-tags"></i><span>Types</span></a>
                <a class="nav-link" asp-page="/Dashboard/Settings">
                    <i class="fas fa-cog"></i>
                    <span>Settings</span>
                </a>
                <a class="nav-link" asp-page="/Termination/Index">
                    <i class="fas fa-user-times"></i>
                    <span>Terminations</span>
                </a>

            </div>


        </nav>

        <main id="content">
            @RenderBody()


        </main>

    </div>

    <script src="~/js/pages.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>