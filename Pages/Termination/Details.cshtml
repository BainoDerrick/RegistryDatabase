@page "{id:int}"
@model RegistryAPI.Pages.Termination.DetailsModel
@{
    ViewData["Title"] = "Termination Details";

    var userName = User.Identity?.Name;
    var firstName = "User";

    if (!string.IsNullOrEmpty(userName) && userName.Contains('@'))
    {
        firstName = userName.Split('@')[0];
        firstName = System.Globalization.CultureInfo.CurrentCulture.TextInfo
        .ToTitleCase(firstName.ToLower());
    }
    else if (!string.IsNullOrEmpty(userName))
    {
        firstName = userName;
    }
}

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="row align-items-center mb-4 pt-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="ministry-badge">
                        <i class="fas fa-user-times"></i>
                    </div>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-warning">
                        Termination Record Details
                    </h1>
                    <p class="text-muted mb-0">
                        Ministry of Works and Transport - Staff Registry
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- DETAILS CARD -->
    <div class="row">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="card border-0 shadow-sm border-warning border-2">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold text-warning">
                        <i class="fas fa-info-circle text-warning me-2"></i>
                        Termination Information
                    </h5>
                </div>

                <div class="card-body">
                    <div class="bg-light rounded p-4">

                        <div class="row g-4">

                            <!-- Record ID -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <div class="text-muted small fw-medium">Record ID</div>
                                    <div class="fw-bold fs-4">
                                        <i class="fas fa-hashtag text-uganda-primary me-2"></i>
                                        @Model.TerminationItem.TerminationId
                                    </div>
                                </div>
                            </div>

                            <!-- Staff Member -->
                            <div class="col-12">
                                <div class="detail-item">
                                    <div class="text-muted small fw-medium">Staff Member</div>
                                    <div class="fw-bold fs-4">
                                        <i class="fas fa-user text-uganda-primary me-2"></i>
                                        @(Model.TerminationItem.Staff != null
                                                                                ? $"{Model.TerminationItem.Staff.FirstName}                                {Model.TerminationItem.Staff.LastName} (ID: {Model.TerminationItem.StaffId})"
                                                                                : $"Staff ID: {Model.TerminationItem.StaffId}")
                                    </div>
                                </div>
                            </div>

                            <!-- Reason -->
                            @if (!string.IsNullOrEmpty(Model.TerminationItem.Reason))
                            {
                                <div class="col-12">
                                    <div class="detail-item">
                                        <div class="text-muted small fw-medium">Reason for Termination</div>
                                        <div class="fw-medium fs-5 text-dark p-3 bg-white rounded border">
                                            @Model.TerminationItem.Reason
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Date -->
                            @if (Model.TerminationItem.CreateDate.HasValue)
                            {
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="text-muted small fw-medium">Recorded On</div>
                                        <div class="fw-bold fs-5">
                                            <i class="fas fa-calendar-alt text-uganda-primary me-2"></i>
                                            @Model.TerminationItem.CreateDate.Value.ToString("dd MMMM yyyy")
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-3 mt-4 pt-4 border-top">
                        <a asp-page="Edit" asp-route-id="@Model.TerminationItem.TerminationId"
                            class="btn btn-warning btn-lg px-5">
                            <i class="fas fa-edit me-2"></i>Edit Record
                        </a>

                        <a asp-page="Index" class="btn btn-outline-secondary btn-lg px-5">
                            <i class="fas fa-list me-2"></i>Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Styles moved to wwwroot/css/pages.css -->