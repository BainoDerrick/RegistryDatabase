@page
@model RegistryAPI.Pages.Termination.CreateModel
@{
    ViewData["Title"] = "Create Termination";

    var userName = User.Identity?.Name;
    var firstName = "User";

    if (!string.IsNullOrEmpty(userName) && userName.Contains('@'))
    {
        firstName = userName.Split('@')[0];
        firstName = System.Globalization.CultureInfo.CurrentCulture.TextInfo
        .ToTitleCase(firstName.ToLower());
    }
    else if (!string.IsNullOrEmpty(userName))
    {
        firstName = userName;
    }
}

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="row align-items-center mb-4 pt-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="ministry-badge">
                        <i class="fas fa-user-times"></i>
                    </div>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-danger">
                        Record Staff Termination
                    </h1>
                    <p class="text-muted mb-0">
                        Ministry of Works and Transport - Staff Registry
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- FULL WIDTH FORM -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm border-warning border-2">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold text-warning">
                        <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                        Termination Details
                    </h5>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning border-0 mb-4">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        This action will set the staff member's status to terminated and record the reason. It cannot be
                        undone without manual intervention.
                    </div>

                    <form method="post">

                        <div class="row g-4">

                            <!-- Staff Selection -->
                            <div class="col-12">
                                <label class="form-label fw-medium">Select Staff Member</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <select asp-for="TerminationItem.StaffId" class="form-select form-select-lg"
                                        asp-items="Model.StaffSelect">
                                        <option value="">-- Select staff member --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="TerminationItem.StaffId" class="text-danger small"></span>
                            </div>

                            <!-- Reason -->
                            <div class="col-12">
                                <label class="form-label fw-medium">Reason for Termination</label>
                                <div class="input-group">
                                    <span class="input-group-text align-top">
                                        <i class="fas fa-align-left"></i>
                                    </span>
                                    <textarea asp-for="TerminationItem.Reason" class="form-control form-control-lg"
                                        rows="6" maxlength="1000"
                                        placeholder="Provide a detailed reason for the termination..."></textarea>
                                </div>
                                <div class="form-text">Maximum 1000 characters. This will be recorded in the audit log.
                                </div>
                                <span asp-validation-for="TerminationItem.Reason" class="text-danger small"></span>
                            </div>

                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-3 mt-4 pt-4 border-top">
                            <button type="submit" class="btn btn-danger btn-lg px-5">
                                <i class="fas fa-user-times me-2"></i>Record Termination
                            </button>

                            <a asp-page="Index" class="btn btn-outline-secondary btn-lg px-5">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Styles moved to ~/css/pages.css (consolidated) -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}