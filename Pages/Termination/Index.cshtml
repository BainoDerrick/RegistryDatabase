@page
@model RegistryAPI.Pages.Termination.IndexModel
@{
    ViewData["Title"] = "Manage Terminations";

    var userName = User.Identity?.Name;
    var firstName = "User";

    if (!string.IsNullOrEmpty(userName) && userName.Contains('@'))
    {
        firstName = userName.Split('@')[0];
        firstName = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(firstName.ToLower());
    }
    else if (!string.IsNullOrEmpty(userName))
    {
        firstName = userName;
    }
}

<div class="container-fluid px-4">
    <!-- Header -->
    <div class="row align-items-center mb-4 pt-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="ministry-badge">
                        <i class="fas fa-user-times"></i>
                    </div>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-warning">Termination Records</h1>
                    <p class="text-muted mb-0">Ministry of Works and Transport - Staff Registry System</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card stats-card bg-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase text-muted mb-2">Total Records</h6>
                            <h2 class="mb-0 fw-bold text-uganda-black">@Model.Terminations.Count()</h2>
                            <p class="text-muted mb-0">All termination records</p>
                        </div>
                        <div class="icon-circle bg-warning-light">
                            <i class="fas fa-user-times text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stats-card bg-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase text-muted mb-2">This Year</h6>
                            <h2 class="mb-0 fw-bold text-warning">@Model.Terminations.Count(t => t.CreateDate?.Year ==
                                                                DateTime.Today.Year)</h2>
                            <p class="text-muted mb-0">Recorded in @DateTime.Today.Year</p>
                        </div>
                        <div class="icon-circle bg-warning-light">
                            <i class="fas fa-calendar-alt text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions Bar -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0 fw-bold">Termination Registry</h5>
                            <p class="text-muted mb-0 small">Manage staff termination records and reasons</p>
                        </div>
                        <div class="d-flex gap-2">
                            <a class="btn btn-warning d-flex align-items-center" asp-page="Create">
                                <i class="fas fa-plus-circle me-2"></i>Record New Termination
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-lg-8">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-uganda-primary-light text-uganda-primary">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="search" name="search" value="@Model.Search" class="form-control"
                                    placeholder="Search terminations (staff name, ID, reason)..." />
                                <button class="btn btn-uganda-primary" type="submit">
                                    <i class="fas fa-search me-1"></i>Search
                                </button>
                                @if (!string.IsNullOrEmpty(Model.Search))
                                {
                                    <a class="btn btn-outline-secondary" href="?">
                                        <i class="fas fa-times me-1"></i>Clear
                                    </a>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Termination Table -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="fw-medium text-uganda-primary">Record ID</th>
                                    <th class="fw-medium text-uganda-primary">Staff Member</th>
                                    <th class="fw-medium text-uganda-primary">Reason</th>
                                    <th class="fw-medium text-uganda-primary">Date Recorded</th>
                                    <th class="fw-medium text-uganda-primary text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Terminations)
                                {
                                    <tr class="termination-row">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="termination-icon me-2">
                                                    <i class="fas fa-user-times text-warning"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">@item.TerminationId</div>
                                                    <small class="text-muted">Record</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-medium">
                                                @(item.Staff != null
                                                                                            ? $"{item.Staff.FirstName} {item.Staff.LastName}"
                                                                                            : "—")
                                            </div>
                                            <small class="text-muted">ID: @item.StaffId</small>
                                        </td>
                                        <td>
                                            <div class="text-muted"
                                                style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                                title="@item.Reason">
                                                @(string.IsNullOrEmpty(item.Reason) ? "— No reason provided —" :
                                                                                            item.Reason)
                                            </div>
                                        </td>
                                        <td>
                                            @(item.CreateDate.HasValue
                                                                                    ? item.CreateDate.Value.ToString("dd MMM yyyy")
                                                                                    : "—")
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group" role="group">
                                                <a asp-page="Details" asp-route-id="@item.TerminationId"
                                                    class="btn btn-sm btn-outline-info" data-bs-toggle="tooltip"
                                                    title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-page="Edit" asp-route-id="@item.TerminationId"
                                                    class="btn btn-sm btn-outline-warning" data-bs-toggle="tooltip"
                                                    title="Edit Record">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-page="Delete" asp-route-id="@item.TerminationId"
                                                    class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip"
                                                    title="Delete Record">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }

                                @if (!Model.Terminations.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5">
                                            <div class="py-4">
                                                <i class="fas fa-user-times fa-3x text-muted mb-3"></i>
                                                <h5 class="text-muted">No termination records found</h5>
                                                <p class="text-muted mb-4">
                                                    @(string.IsNullOrEmpty(Model.Search)
                                                                                                    ? "No staff terminations have been recorded yet."
                                                                                                    : "No records match your search criteria.")
                                                </p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Table Footer -->
                @if (Model.Terminations.Any())
                {
                    <div class="card-footer bg-white border-0 py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="text-muted">
                                Showing <strong>@Model.Terminations.Count()</strong> termination record(s)
                                @if (!string.IsNullOrEmpty(Model.Search))
                                {
                                    <span>matching "<strong>@Model.Search</strong>"</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- Styles and page scripts moved to wwwroot/css/pages.css and wwwroot/js/pages.js -->