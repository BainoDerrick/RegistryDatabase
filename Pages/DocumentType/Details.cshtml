@page "{id:int}"
@model RegistryAPI.Pages.DocumentType.DetailsModel
@{
    ViewData["Title"] = "Document Type Details";
}

<h1>Document Type Details</h1>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.DocType.DocTypeId</dd>
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.DocType.TypeName</dd>
    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.DocType.Description</dd>
</dl>

<a asp-page="Edit" asp-route-id="@Model.DocType.DocTypeId" class="btn btn-warning">Edit</a>
<a asp-page="Index" class="btn btn-secondary">Back to list</a>
