@page "{id}"
@model RegistryAPI.Pages.Staff.DetailsModel
@{
    ViewData["Title"] = "Staff Details";

    var userName = User.Identity?.Name;
    var firstName = "User";

    if (!string.IsNullOrEmpty(userName) && userName.Contains('@'))
    {
        firstName = userName.Split('@')[0];
        firstName = System.Globalization.CultureInfo.CurrentCulture.TextInfo
        .ToTitleCase(firstName.ToLower());
    }
    else if (!string.IsNullOrEmpty(userName))
    {
        firstName = userName;
    }
}

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="row align-items-center mb-4 pt-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="ministry-badge">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-uganda-primary">
                        Staff Member Details
                    </h1>
                    <p class="text-muted mb-0">
                        Ministry of Works and Transport - Staff Registry
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- DETAILS CARD -->
    <div class="row">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-info-circle text-uganda-primary me-2"></i>
                        Staff Information
                    </h5>
                </div>

                <div class="card-body">
                    <div class="bg-light rounded p-4">

                        <div class="row g-4">

                            <!-- Staff ID -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <div class="text-muted small fw-medium">Staff ID</div>
                                    <div class="fw-bold fs-4">
                                        <i class="fas fa-id-badge text-uganda-primary me-2"></i>
                                        @Model.StaffItem.StaffId
                                    </div>
                                </div>
                            </div>

                            <!-- Full Name -->
                            <div class="col-12">
                                <div class="detail-item">
                                    <div class="text-muted small fw-medium">Full Name</div>
                                    <div class="fw-bold fs-4">
                                        <i class="fas fa-user text-uganda-primary me-2"></i>
                                        @Model.StaffItem.FirstName @Model.StaffItem.LastName
                                    </div>
                                </div>
                            </div>

                            <!-- Email -->
                            @if (!string.IsNullOrEmpty(Model.StaffItem.Email))
                            {
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="text-muted small fw-medium">Email Address</div>
                                        <div class="fw-bold fs-5">
                                            <i class="fas fa-envelope text-uganda-primary me-2"></i>
                                            @Model.StaffItem.Email
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Department -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <div class="text-muted small fw-medium">Department</div>
                                    <div class="fw-bold fs-5">
                                        <i class="fas fa-building text-uganda-primary me-2"></i>
                                        @(Model.StaffItem.DeptCode ?? "Not assigned")
                                    </div>
                                </div>
                            </div>

                            <!-- Employment Type -->
                            @if (!string.IsNullOrEmpty(Model.StaffItem.EmploymentType))
                            {
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="text-muted small fw-medium">Employment Type</div>
                                        <div class="fw-bold fs-5">
                                            <i class="fas fa-briefcase text-uganda-primary me-2"></i>
                                            @Model.StaffItem.EmploymentType
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Title -->
                            @if (!string.IsNullOrEmpty(Model.StaffItem.Title))
                            {
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="text-muted small fw-medium">Job Title</div>
                                        <div class="fw-bold fs-5">
                                            <i class="fas fa-id-card text-uganda-primary me-2"></i>
                                            @Model.StaffItem.Title
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Hire Date -->
                            @if (Model.StaffItem.HireDate.HasValue)
                            {
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="text-muted small fw-medium">Hire Date</div>
                                        <div class="fw-bold fs-5">
                                            <i class="fas fa-calendar-check text-uganda-primary me-2"></i>
                                            @Model.StaffItem.HireDate.Value.ToString("dd MMMM yyyy")
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Termination Date -->
                            @if (Model.StaffItem.TerminationDate.HasValue)
                            {
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="text-muted small fw-medium">Termination Date</div>
                                        <div class="fw-bold fs-5">
                                            <i class="fas fa-calendar-times text-uganda-primary me-2"></i>
                                            @Model.StaffItem.TerminationDate.Value.ToString("dd MMMM yyyy")
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Role -->
                            @if (!string.IsNullOrEmpty(Model.StaffItem.Role))
                            {
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="text-muted small fw-medium">Role / Position</div>
                                        <div class="fw-bold fs-5">
                                            <i class="fas fa-user-tie text-uganda-primary me-2"></i>
                                            @Model.StaffItem.Role
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-3 mt-4 pt-4 border-top">
                        <a asp-page="Edit" asp-route-id="@Model.StaffItem.StaffId" class="btn btn-warning btn-lg px-5">
                            <i class="fas fa-edit me-2"></i>Edit Staff Member
                        </a>

                        <a asp-page="Index" class="btn btn-outline-secondary btn-lg px-5">
                            <i class="fas fa-list me-2"></i>Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Styles moved to ~/css/pages.css (consolidated) -->