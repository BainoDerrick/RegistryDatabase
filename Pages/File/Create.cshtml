@page
@model RegistryAPI.Pages.File.CreateModel
@{
    ViewData["Title"] = "Create File";

    var userName = User.Identity?.Name;
    var firstName = "User";

    if (!string.IsNullOrEmpty(userName) && userName.Contains('@'))
    {
        firstName = userName.Split('@')[0];
        firstName = System.Globalization.CultureInfo.CurrentCulture.TextInfo
        .ToTitleCase(firstName.ToLower());
    }
    else if (!string.IsNullOrEmpty(userName))
    {
        firstName = userName;
    }
}

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="row align-items-center mb-4 pt-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="ministry-badge">
                        <i class="fas fa-folder-plus"></i>
                    </div>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-uganda-primary">
                        Create New File
                    </h1>
                    <p class="text-muted mb-0">
                        Ministry of Works and Transport - File Registry
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- FULL WIDTH FORM -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-plus-circle text-success me-2"></i>
                        File Information
                    </h5>
                </div>

                <div class="card-body">
                    <form method="post">

                        <div class="row g-4">
                            <!-- Staff (Optional) -->
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Assigned Staff (Optional)</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <select asp-for="FileItem.StaffId" class="form-select form-select-lg"
                                        asp-items="Model.StaffOptions">
                                        <option value="">-- Select staff --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="FileItem.StaffId" class="text-danger small"></span>
                            </div>

                            <!-- File Status -->
                            <div class="col-md-6">
                                <label class="form-label fw-medium">File Status</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-info-circle"></i>
                                    </span>
                                    <select asp-for="FileItem.FileStatus" class="form-select form-select-lg">
                                        <option value="Open">Open</option>
                                        <option value="Active">Active</option>
                                        <option value="Closed">Closed</option>
                                        <option value="Archived">Archived</option>
                                    </select>
                                </div>
                                <span asp-validation-for="FileItem.FileStatus" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-3 mt-4 pt-4 border-top">
                            <button type="submit" class="btn btn-uganda-primary btn-lg px-5">
                                <i class="fas fa-save me-2"></i>Create File
                            </button>

                            <a asp-page="Index" class="btn btn-outline-secondary btn-lg px-5">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>

                    <!-- Existing Files Reference -->
                    <div class="mt-5">
                        <h6 class="fw-bold text-uganda-primary mb-3">
                            <i class="fas fa-folder-open me-2"></i>Existing Files (for reference only)
                        </h6>

                        @if (Model.ExistingFiles != null && Model.ExistingFiles.Any())
                        {
                            <div class="border rounded p-3 bg-light existing-files-list">
                                <select class="form-select" size="8" disabled>
                                    @foreach (var f in Model.ExistingFiles)
                                    {
                                        <option value="@f.Value">@f.Text</option>
                                    }
                                </select>
                                <small class="text-muted mt-2 d-block">This list is read-only and shown for
                                    reference.</small>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info border-0">
                                <i class="fas fa-info-circle me-2"></i>
                                No existing files in the registry yet.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Styles moved to ~/css/pages.css (consolidated) -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}