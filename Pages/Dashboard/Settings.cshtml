@page
@model RegistryAPI.Pages.Dashboard.SettingsModel
@{
    ViewData["Title"] = "System Settings";

    // Extract first name from email for avatar
    var userName = User.Identity?.Name;
    var firstName = "User";

    if (!string.IsNullOrEmpty(userName) && userName.Contains('@'))
    {
        firstName = userName.Split('@')[0];
        firstName = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(firstName.ToLower());
    }
    else if (!string.IsNullOrEmpty(userName))
    {
        firstName = userName;
    }
}

<div class="container-fluid px-4">
    <!-- Header Section -->
    <div class="row align-items-center mb-4 pt-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="ministry-badge">
                        <i class="fas fa-cogs"></i>
                    </div>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-uganda-primary">System Settings</h1>
                    <p class="text-muted mb-0">Ministry of Works and Transport - Configuration Center</p>
                </div>
            </div>
        </div>



        <!-- Settings Content -->
        <div class="tab-content" id="settingsTabContent">
            <!-- Appearance Tab -->
            <div class="tab-pane fade show active" id="appearance" role="tabpanel" aria-labelledby="appearance-tab">
                <div class="row g-4">
                    <!-- Theme Selection -->
                    <div class="col-xl-6">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white border-0 py-3">
                                <h5 class="mb-0 fw-bold"><i class="fas fa-palette text-uganda-primary me-2"></i>Theme
                                    Settings</h5>
                            </div>
                            <div class="card-body">
                                <p class="text-muted mb-4">Choose your preferred interface theme. Changes will be
                                    applied
                                    immediately.</p>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="theme-card light-theme-card" data-theme="light">
                                            <div class="theme-preview">
                                                <div class="theme-header"></div>
                                                <div class="theme-content">
                                                    <div class="theme-sidebar"></div>
                                                    <div class="theme-main"></div>
                                                </div>
                                            </div>
                                            <div class="theme-info mt-3">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <h6 class="mb-0">Light Theme</h6>
                                                        <small class="text-muted">Default Ministry Theme</small>
                                                    </div>
                                                    <div class="theme-radio">
                                                        <input type="radio" name="theme" id="themeLight" value="light"
                                                            class="form-check-input">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="theme-card dark-theme-card" data-theme="dark">
                                            <div class="theme-preview dark">
                                                <div class="theme-header"></div>
                                                <div class="theme-content">
                                                    <div class="theme-sidebar"></div>
                                                    <div class="theme-main"></div>
                                                </div>
                                            </div>
                                            <div class="theme-info mt-3">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <h6 class="mb-0">Dark Theme</h6>
                                                        <small class="text-muted">Low-light Environment</small>
                                                    </div>
                                                    <div class="theme-radio">
                                                        <input type="radio" name="theme" id="themeDark" value="dark"
                                                            class="form-check-input">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4">
                                    <button id="applyTheme" class="btn btn-uganda-primary">
                                        <i class="fas fa-check me-2"></i>Apply Theme
                                    </button>
                                    <button id="resetTheme" class="btn btn-outline-secondary ms-2">
                                        <i class="fas fa-undo me-2"></i>Reset to Default
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Display Settings -->
                    <div class="col-xl-6">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white border-0 py-3">
                                <h5 class="mb-0 fw-bold"><i class="fas fa-desktop text-success me-2"></i>Display
                                    Settings
                                </h5>
                            </div>
                            <div class="card-body">
                                <!-- Zoom Control -->
                                <div class="mb-4">
                                    <label class="form-label fw-medium">Text Size & Zoom</label>
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="fas fa-search-minus text-muted me-2"></i>
                                        <input id="zoomRange" type="range" min="80" max="150" step="5" value="100"
                                            class="form-range flex-grow-1 mx-3" />
                                        <i class="fas fa-search-plus text-muted ms-2"></i>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <span id="zoomValue" class="badge bg-uganda-primary">100%</span>
                                            <small class="text-muted ms-2">Current zoom level</small>
                                        </div>
                                        <button id="resetZoom" class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-undo me-1"></i>Reset
                                        </button>
                                    </div>
                                    <div class="form-text">
                                        Adjust the zoom level for better readability. Settings are saved per browser.
                                    </div>
                                </div>

                                <hr class="my-4">
                            </div>


                        </div>

                        <style>
                            /* Settings Page Specific Styles */
                            .settings-nav {
                                background: white;
                                border-radius: 10px;
                                padding: 0.5rem;
                                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
                            }

                            .settings-nav .nav-link {
                                color: #6c757d;
                                border: none;
                                padding: 0.75rem 1.5rem;
                                border-radius: 8px;
                                font-weight: 500;
                                transition: all 0.3s ease;
                            }

                            .settings-nav .nav-link:hover {
                                color: var(--uganda-primary);
                                background: rgba(0, 102, 204, 0.05);
                            }

                            .settings-nav .nav-link.active {
                                color: white;
                                background: var(--uganda-primary);
                                box-shadow: 0 4px 12px rgba(68, 69, 69, 0.042);
                            }

                            /* Theme Cards */
                            .theme-card {
                                background: white;
                                border: 2px solid #e9ecef;
                                border-radius: 12px;
                                padding: 1.5rem;
                                cursor: pointer;
                                transition: all 0.3s ease;
                            }

                            .theme-card:hover {
                                border-color: var(--uganda-primary);
                                transform: translateY(-2px);
                                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
                            }

                            .theme-card.active {
                                border-color: var(--uganda-primary);
                                background: rgba(0, 102, 204, 0.03);
                            }

                            .theme-preview {
                                height: 120px;
                                background: #f8f9fa;
                                border-radius: 8px;
                                overflow: hidden;
                                border: 1px solid #dee2e6;
                            }

                            .theme-preview.dark {
                                background: #1a1a1a;
                                border-color: #343a40;
                            }

                            .theme-header {
                                height: 20px;
                                background: var(--uganda-primary);
                                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                            }

                            .theme-content {
                                display: flex;
                                height: calc(100% - 20px);
                                padding: 8px;
                            }

                            .theme-sidebar {
                                width: 25%;
                                background: #e9ecef;
                                border-radius: 4px;
                                margin-right: 8px;
                            }

                            .theme-preview.dark .theme-sidebar {
                                background: #2d3748;
                            }

                            .theme-main {
                                flex: 1;
                                background: white;
                                border-radius: 4px;
                            }

                            .theme-preview.dark .theme-main {
                                background: #4a5568;
                            }

                            .theme-info {
                                cursor: pointer;
                            }

                            .theme-radio .form-check-input {
                                cursor: pointer;
                            }

                            .theme-radio .form-check-input:checked {
                                background-color: var(--uganda-primary);
                                border-color: var(--uganda-primary);
                            }

                            /* Form Controls */
                            .form-range::-webkit-slider-thumb {
                                background-color: var(--uganda-primary);
                            }

                            .form-range::-moz-range-thumb {
                                background-color: var(--uganda-primary);
                            }

                            .form-check-input:checked {
                                background-color: var(--uganda-primary);
                                border-color: var(--uganda-primary);
                            }

                            .form-check-input:focus {
                                border-color: var(--uganda-primary);
                                box-shadow: 0 0 0 0.25rem rgba(0, 102, 204, 0.25);
                            }

                            /* Buttons */
                            .btn-uganda-primary {
                                background-color: var(--uganda-primary);
                                border-color: var(--uganda-primary);
                                color: white;
                            }

                            .btn-uganda-primary:hover {
                                background-color: #0052a3;
                                border-color: #0052a3;
                                color: white;
                            }

                            /* Badges */
                            .badge {
                                padding: 0.35em 0.65em;
                                font-weight: 500;
                            }

                            /* Alert Colors */
                            .alert-info {
                                background-color: rgba(13, 202, 240, 0.1);
                                border-color: rgba(13, 202, 240, 0.2);
                                color: #055160;
                            }

                            .alert-warning {
                                background-color: rgba(255, 193, 7, 0.1);
                                border-color: rgba(255, 193, 7, 0.2);
                                color: #664d03;
                            }

                            .alert-danger {
                                background-color: rgba(220, 53, 69, 0.1);
                                border-color: rgba(220, 53, 69, 0.2);
                                color: #842029;
                            }

                            /* Tab Content */
                            .tab-content {
                                padding-top: 1.5rem;
                            }

                            /* Responsive */
                            @@media (max-width: 768px) {
                                .settings-nav .nav-link {
                                    padding: 0.5rem 1rem;
                                    font-size: 0.875rem;
                                }

                                .theme-card {
                                    padding: 1rem;
                                }
                            }
                        </style>

@section Scripts {
                            <script>
                                document.addEventListener('DOMContentLoaded', function () {
                                    // Initialize Bootstrap components
                                    try {
                                        // Initialize dropdowns
                                        var dropdownElements = document.querySelectorAll('[data-bs-toggle="dropdown"]');
                                        dropdownElements.forEach(function (dropdownElement) {
                                            try {
                                                new bootstrap.Dropdown(dropdownElement);
                                            } catch (e) {
                                                console.warn('Failed to initialize dropdown:', e);
                                            }
                                        });

                                        // Initialize tabs
                                        var tabElements = document.querySelectorAll('[data-bs-toggle="tab"]');
                                        tabElements.forEach(function (tabElement) {
                                            tabElement.addEventListener('click', function (e) {
                                                e.preventDefault();
                                                var target = document.querySelector(this.getAttribute('data-bs-target'));
                                                if (target) {
                                                    // Hide all tab panes
                                                    document.querySelectorAll('.tab-pane').forEach(function (pane) {
                                                        pane.classList.remove('show', 'active');
                                                    });

                                                    // Remove active class from all tabs
                                                    tabElements.forEach(function (tab) {
                                                        tab.classList.remove('active');
                                                    });

                                                    // Show selected tab
                                                    this.classList.add('active');
                                                    target.classList.add('show', 'active');
                                                }
                                            });
                                        });
                                    } catch (e) {
                                        console.warn('Bootstrap initialization failed:', e);
                                    }

                                    // Theme functionality
                                    const themeCards = document.querySelectorAll('.theme-card');
                                    const applyThemeBtn = document.getElementById('applyTheme');
                                    const resetThemeBtn = document.getElementById('resetTheme');

                                    // Load saved theme from localStorage
                                    const savedTheme = localStorage.getItem('registry_theme') || 'light';

                                    // Set initial theme selection
                                    themeCards.forEach(card => {
                                        const radio = card.querySelector('input[type="radio"]');
                                        if (radio && radio.value === savedTheme) {
                                            radio.checked = true;
                                            card.classList.add('active');
                                        }

                                        // Card click selects radio
                                        card.addEventListener('click', function (e) {
                                            if (!e.target.matches('input[type="radio"]')) {
                                                const radio = this.querySelector('input[type="radio"]');
                                                if (radio) {
                                                    radio.checked = true;

                                                    // Update active state
                                                    themeCards.forEach(c => c.classList.remove('active'));
                                                    this.classList.add('active');
                                                }
                                            }
                                        });
                                    });

                                    // Apply theme
                                    if (applyThemeBtn) {
                                        applyThemeBtn.addEventListener('click', function () {
                                            const selectedTheme = document.querySelector('input[name="theme"]:checked');
                                            if (selectedTheme) {
                                                const theme = selectedTheme.value;
                                                localStorage.setItem('registry_theme', theme);
                                                applyTheme(theme);
                                                showToast('Theme applied successfully!', 'success');
                                                updateLastSaved();
                                            }
                                        });
                                    }

                                    // Reset theme
                                    if (resetThemeBtn) {
                                        resetThemeBtn.addEventListener('click', function () {
                                            localStorage.setItem('registry_theme', 'light');
                                            document.querySelectorAll('input[name="theme"]').forEach(radio => {
                                                radio.checked = radio.value === 'light';
                                            });
                                            themeCards.forEach(card => {
                                                card.classList.remove('active');
                                                if (card.querySelector('input[value="light"]')) {
                                                    card.classList.add('active');
                                                }
                                            });
                                            applyTheme('light');
                                            showToast('Theme reset to default!', 'success');
                                            updateLastSaved();
                                        });
                                    }

                                    // Apply theme function
                                    function applyTheme(theme) {
                                        if (theme === 'dark') {
                                            document.documentElement.setAttribute('data-bs-theme', 'dark');
                                            document.body.classList.add('dark-theme');
                                        } else {
                                            document.documentElement.removeAttribute('data-bs-theme');
                                            document.body.classList.remove('dark-theme');
                                        }
                                    }

                                    // Apply saved theme on load
                                    applyTheme(savedTheme);

                                    // Zoom functionality
                                    const zoomRange = document.getElementById('zoomRange');
                                    const zoomValue = document.getElementById('zoomValue');
                                    const resetZoomBtn = document.getElementById('resetZoom');

                                    // Load saved zoom from localStorage
                                    const savedZoom = localStorage.getItem('registry_zoom') || '100';

                                    if (zoomRange && zoomValue) {
                                        // Set initial values
                                        zoomRange.value = savedZoom;
                                        zoomValue.textContent = savedZoom + '%';

                                        // Apply initial zoom
                                        applyZoom(savedZoom);

                                        // Update on change
                                        zoomRange.addEventListener('input', function () {
                                            const value = this.value + '%';
                                            zoomValue.textContent = value;
                                        });

                                        zoomRange.addEventListener('change', function () {
                                            const zoom = this.value;
                                            localStorage.setItem('registry_zoom', zoom);
                                            applyZoom(zoom);
                                            showToast('Zoom level updated!', 'success');
                                            updateLastSaved();
                                        });
                                    }

                                    if (resetZoomBtn) {
                                        resetZoomBtn.addEventListener('click', function () {
                                            if (zoomRange) {
                                                zoomRange.value = '100';
                                                zoomValue.textContent = '100%';
                                                localStorage.setItem('registry_zoom', '100');
                                                applyZoom('100');
                                                showToast('Zoom reset to default!', 'success');
                                                updateLastSaved();
                                            }
                                        });
                                    }

                                    // Apply zoom function
                                    function applyZoom(zoom) {
                                        const zoomPercent = parseInt(zoom) / 100;
                                        document.body.style.fontSize = (zoomPercent * 1) + 'rem';
                                        document.body.style.transform = 'scale(' + zoomPercent + ')';
                                        document.body.style.transformOrigin = 'top left';
                                        document.body.style.width = (100 / zoomPercent) + '%';
                                    }

                                    // Load saved toggle states
                                    document.querySelectorAll('.form-check-input').forEach(toggle => {
                                        const id = toggle.id;
                                        const savedState = localStorage.getItem('registry_setting_' + id);
                                        if (savedState !== null) {
                                            toggle.checked = savedState === 'true';
                                        }

                                        // Save on change
                                        toggle.addEventListener('change', function () {
                                            localStorage.setItem('registry_setting_' + this.id, this.checked);
                                            showToast('Setting saved!', 'success');
                                            updateLastSaved();
                                        });
                                    });

                                    // Load saved selects
                                    document.querySelectorAll('select').forEach(select => {
                                        const id = select.id || select.name;
                                        const savedValue = localStorage.getItem('registry_select_' + id);
                                        if (savedValue !== null) {
                                            select.value = savedValue;
                                        }

                                        // Save on change
                                        select.addEventListener('change', function () {
                                            const id = this.id || this.name;
                                            localStorage.setItem('registry_select_' + id, this.value);
                                            showToast('Setting saved!', 'success');
                                            updateLastSaved();
                                        });
                                    });

                                    // Save buttons
                                    document.querySelectorAll('.btn-uganda-primary').forEach(btn => {
                                        if (!btn.id && !btn.classList.contains('apply-theme')) {
                                            btn.addEventListener('click', function () {
                                                showToast('Settings saved successfully!', 'success');
                                                updateLastSaved();
                                            });
                                        }
                                    });

                                    // Update last saved time
                                    function updateLastSaved() {
                                        const now = new Date();
                                        const timeString = now.toLocaleTimeString('en-US', {
                                            hour: '2-digit',
                                            minute: '2-digit',
                                            second: '2-digit'
                                        });
                                        document.getElementById('lastSavedTime').textContent = timeString;
                                    }

                                    // Initialize last saved time
                                    const lastSaved = localStorage.getItem('registry_last_saved');
                                    if (lastSaved) {
                                        document.getElementById('lastSavedTime').textContent = lastSaved;
                                    }

                                    // Toast notification function
                                    function showToast(message, type = 'info') {
                                        // Remove existing toasts
                                        const existingToasts = document.querySelectorAll('.toast-container');
                                        existingToasts.forEach(toast => toast.remove());

                                        // Create toast container
                                        const toastContainer = document.createElement('div');
                                        toastContainer.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                                        toastContainer.style.zIndex = '1050';

                                        // Create toast
                                        const toast = document.createElement('div');
                                        toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : 'info'} border-0`;
                                        toast.setAttribute('role', 'alert');
                                        toast.setAttribute('aria-live', 'assertive');
                                        toast.setAttribute('aria-atomic', 'true');

                                        toast.innerHTML = `
                                            <div class="d-flex">
                                                <div class="toast-body">
                                                    <i class="fas fa-${type === 'success' ? 'check-circle' : 'info-circle'} me-2"></i>
                                                    ${message}
                                                </div>
                                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                                            </div>
                                        `;

                                        toastContainer.appendChild(toast);
                                        document.body.appendChild(toastContainer);

                                        // Initialize and show toast
                                        const bsToast = new bootstrap.Toast(toast, { delay: 3000 });
                                        bsToast.show();

                                        // Auto-remove after hide
                                        toast.addEventListener('hidden.bs.toast', function () {
                                            toastContainer.remove();
                                        });
                                    }

                                    // Add CSS for toast
                                    const toastStyle = document.createElement('style');
                                    toastStyle.textContent = `
                                        .toast {
                                            opacity: 1;
                                            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
                                        }
                
                                        .dark-theme .toast {
                                            background-color: #2d3748 !important;
                                            color: #e2e8f0 !important;
                                        }
                                    `;
                                    document.head.appendChild(toastStyle);

                                    // Add CSS for dark theme
                                    const darkThemeStyle = document.createElement('style');
                                    darkThemeStyle.textContent = `
                                        .dark-theme {
                                            background-color: #1a1a1a;
                                            color: #e2e8f0;
                                        }
                
                                        .dark-theme .card {
                                            background-color: #2d3748;
                                            border-color: #4a5568;
                                        }
                
                                        .dark-theme .card-header {
                                            background-color: #2d3748;
                                            border-bottom-color: #4a5568;
                                        }
                
                                        .dark-theme .text-muted {
                                            color: #a0aec0 !important;
                                        }
                
                                        .dark-theme .form-control,
                                        .dark-theme .form-select {
                                            background-color: #4a5568;
                                            border-color: #718096;
                                            color: #e2e8f0;
                                        }
                
                                        .dark-theme .form-range::-webkit-slider-thumb {
                                            background-color: var(--uganda-primary);
                                        }
                
                                        .dark-theme .form-range::-moz-range-thumb {
                                            background-color: var(--uganda-primary);
                                        }
                                    `;
                                    document.head.appendChild(darkThemeStyle);
                                });
                            </script>
}