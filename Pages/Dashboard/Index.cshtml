@page
@model RegistryAPI.Pages.Dashboard.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";

    // Extract first name from email
    var userName = User.Identity?.Name;
    var firstName = "User";

    if (!string.IsNullOrEmpty(userName) && userName.Contains('@'))
    {
        firstName = userName.Split('@')[0];
        // Capitalize first letter
        firstName = CultureInfo.CurrentCulture.TextInfo.ToTitleCase(firstName.ToLower());
    }
    else if (!string.IsNullOrEmpty(userName))
    {
        firstName = userName;
    }
}

<div class="container-fluid px-4">
    <!-- Header Section with Ministry Styling -->
    <div class="row align-items-center mb-4 pt-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="ministry-badge">
                        <i class="fas fa-landmark"></i>
                    </div>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-uganda-primary">Registry System Dashboard</h1>
                    <p class="text-muted mb-0">Ministry of Works and Transport - Registry Management System</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 text-end">
            <div class="d-flex align-items-center justify-content-end">
                <div class="me-3 text-end">
                    <div class="fw-medium text-dark">Welcome, @firstName</div>
                    <small class="text-muted">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</small>
                </div>
                <div class="d-flex align-items-center">
                    <div class="user-avatar bg-uganda-yellow me-2">@firstName.Substring(0, 1).ToUpper()</div>
                    <div class="d-none d-md-flex align-items-center">
                        <a asp-page="/Account/Logout" class="small text-decoration-none text-danger"><i
                                class="fas fa-sign-out-alt me-1"></i>Logout</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards Grid -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card stats-card bg-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase text-muted mb-2">Departments</h6>
                            <h2 class="mb-0 fw-bold text-uganda-black">@Model.DepartmentCount</h2>
                            <p class="text-muted mb-0">Total Departments</p>
                        </div>
                        <div class="icon-circle bg-uganda-primary-light">
                            <i class="fas fa-building text-uganda-primary"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="badge bg-light text-dark"><i class="fas fa-check-circle text-success me-1"></i>
                            Operational</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stats-card bg-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase text-muted mb-2">Staff Members</h6>
                            <h2 class="mb-0 fw-bold text-uganda-black">@Model.StaffCount</h2>
                            <div class="d-flex align-items-center mt-2">
                                <span class="badge bg-success me-2">@Model.ActiveStaffCount Active</span>
                                <span class="badge bg-secondary">@Model.InactiveStaffCount Inactive</span>
                            </div>
                        </div>
                        <div class="icon-circle bg-success-light">
                            <i class="fas fa-users text-success"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="progress" style="height: 4px;">
                            <div class="progress-bar bg-success"
                                style="width: @((Model.ActiveStaffCount * 100) / Math.Max(Model.StaffCount, 1))%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stats-card bg-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase text-muted mb-2">Files</h6>
                            <h2 class="mb-0 fw-bold text-uganda-black">@Model.FileCount</h2>
                            <p class="text-muted mb-0">Total Files Registered</p>
                        </div>
                        <div class="icon-circle bg-info-light">
                            <i class="fas fa-folder text-info"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="text-muted"><i class="fas fa-sync-alt me-1"></i> Updated daily</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stats-card bg-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase text-muted mb-2">Documents</h6>
                            <h2 class="mb-0 fw-bold text-uganda-black">@Model.DocumentCount</h2>
                            <p class="text-muted mb-0">Total Documents</p>
                        </div>
                        <div class="icon-circle bg-warning-light">
                            <i class="fas fa-file-alt text-warning"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="text-success"><i class="fas fa-arrow-up me-1"></i>
                            @Model.DocumentsByMonthCounts.LastOrDefault() this month</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Second Row: Additional Stats -->
    <div class="row g-4 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="card stats-card bg-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase text-muted mb-2">Terminations</h6>
                            <h2 class="mb-0 fw-bold text-danger">@Model.TerminationCount</h2>
                            <p class="text-muted mb-0">Staff Terminations</p>
                        </div>
                        <div class="icon-circle bg-danger-light">
                            <i class="fas fa-user-slash text-danger"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="alert alert-danger-light border-0 py-2">
                            <small><i class="fas fa-exclamation-triangle me-1"></i> Requires attention</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card stats-card bg-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase text-muted mb-2">Active Ratio</h6>
                            <h2 class="mb-0 fw-bold text-uganda-black">
                                @(Model.StaffCount > 0 ? ((Model.ActiveStaffCount * 100) / Model.StaffCount) : 0)%
                            </h2>
                            <p class="text-muted mb-0">Staff Active Rate</p>
                        </div>
                        <div class="icon-circle bg-dark-light">
                            <i class="fas fa-chart-line text-dark"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-success"
                                style="width: @(Model.StaffCount > 0 ? ((Model.ActiveStaffCount * 100) / Model.StaffCount) : 0)%">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card stats-card bg-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase text-muted mb-2">System Health</h6>
                            <h2 class="mb-0 fw-bold text-success">100%</h2>
                            <p class="text-muted mb-0">All Systems Operational</p>
                        </div>
                        <div class="icon-circle bg-success-light">
                            <i class="fas fa-shield-alt text-success"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="badge bg-success"><i class="fas fa-check me-1"></i> Optimal</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts and Actions Section -->
    <div class="row g-4 mb-4">
        <!-- Quick Actions -->
        <div class="col-xl-4 col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-bolt text-uganda-yellow me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <a href="/Staff" class="list-group-item list-group-item-action border-0 py-3 px-4">
                            <div class="d-flex align-items-center">
                                <div class="action-icon bg-uganda-primary">
                                    <i class="fas fa-users text-white"></i>
                                </div>
                                <div class="ms-3">
                                    <h6 class="mb-0">Manage Staff</h6>
                                    <small class="text-muted">Add, edit, or view staff members</small>
                                </div>
                                <div class="ms-auto">
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </div>
                            </div>
                        </a>
                        <a href="/Department" class="list-group-item list-group-item-action border-0 py-3 px-4">
                            <div class="d-flex align-items-center">
                                <div class="action-icon bg-success">
                                    <i class="fas fa-building text-white"></i>
                                </div>
                                <div class="ms-3">
                                    <h6 class="mb-0">Manage Departments</h6>
                                    <small class="text-muted">Department management</small>
                                </div>
                                <div class="ms-auto">
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </div>
                            </div>
                        </a>
                        <a href="/File" class="list-group-item list-group-item-action border-0 py-3 px-4">
                            <div class="d-flex align-items-center">
                                <div class="action-icon bg-info">
                                    <i class="fas fa-folder text-white"></i>
                                </div>
                                <div class="ms-3">
                                    <h6 class="mb-0">Manage Files</h6>
                                    <small class="text-muted">File registry operations</small>
                                </div>
                                <div class="ms-auto">
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </div>
                            </div>
                        </a>
                        <a href="/Document" class="list-group-item list-group-item-action border-0 py-3 px-4">
                            <div class="d-flex align-items-center">
                                <div class="action-icon bg-warning">
                                    <i class="fas fa-file-alt text-white"></i>
                                </div>
                                <div class="ms-3">
                                    <h6 class="mb-0">Manage Documents</h6>
                                    <small class="text-muted">Document tracking system</small>
                                </div>
                                <div class="ms-auto">
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </div>
                            </div>
                        </a>
                        <a href="/DocumentType" class="list-group-item list-group-item-action border-0 py-3 px-4">
                            <div class="d-flex align-items-center">
                                <div class="action-icon bg-purple">
                                    <i class="fas fa-tags text-white"></i>
                                </div>
                                <div class="ms-3">
                                    <h6 class="mb-0">Manage Document Types</h6>
                                    <small class="text-muted">Document classification</small>
                                </div>
                                <div class="ms-auto">
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </div>
                            </div>
                        </a>
                        <a href="/Termination" class="list-group-item list-group-item-action border-0 py-3 px-4">
                            <div class="d-flex align-items-center">
                                <div class="action-icon bg-danger">
                                    <i class="fas fa-user-times text-white"></i>
                                </div>
                                <div class="ms-3">
                                    <h6 class="mb-0">Manage Terminations</h6>
                                    <small class="text-muted">Staff termination records</small>
                                </div>
                                <div class="ms-auto">
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Documents Trend Chart -->
        <div class="col-xl-8 col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-chart-line text-uganda-primary me-2"></i>Documents This
                        Year</h5>
                    <div>
                        <span class="badge bg-light text-dark">This Year</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="position: relative; height: 250px;">
                        <canvas id="docsByMonthChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Small Charts Row -->
    <div class="row g-4 mb-4">
        <!-- Documents by Type -->
        <div class="col-xl-6 col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-chart-pie text-success me-2"></i>Documents by Type</h5>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-7">
                            <div class="chart-container" style="position: relative; height: 200px;">
                                <canvas id="docsByTypeChart"></canvas>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="legend-container">
                                <!-- Legend will be populated by JavaScript -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Staff by Department -->
        <div class="col-xl-6 col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-chart-bar text-info me-2"></i>Staff by Department</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="position: relative; height: 200px;">
                        <canvas id="staffByDeptChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- System Health Status -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-server text-uganda-black me-2"></i>System Overview</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="system-status-card p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="status-indicator bg-success me-3"></div>
                                    <div>
                                        <h6 class="mb-0">Staff Management</h6>
                                        <small class="text-muted">@Model.StaffCount records</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="system-status-card p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="status-indicator bg-success me-3"></div>
                                    <div>
                                        <h6 class="mb-0">Document Tracking</h6>
                                        <small class="text-muted">@Model.DocumentCount documents</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="system-status-card p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="status-indicator bg-success me-3"></div>
                                    <div>
                                        <h6 class="mb-0">File Registry</h6>
                                        <small class="text-muted">@Model.FileCount files</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="system-status-card p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="status-indicator bg-success me-3"></div>
                                    <div>
                                        <h6 class="mb-0">Transaction System</h6>
                                        <small class="text-muted">Real-time updates</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Note -->
    <div class="row">
        <div class="col-12">
            <div class="text-center text-muted py-3">
                <small>
                    <i class="fas fa-lock me-1"></i> 2025 Ministry of Works and Transport - Secure Registry System v1.0
                    | Last updated: @DateTime.Now.ToString("HH:mm")
                    | <i class="fas fa-user-shield ms-2 me-1"></i>@firstName
                </small>
            </div>
        </div>
    </div>
</div>

<style>
    /* Uganda Colors */
    :root {
        --uganda-black: #000000;
        --uganda-yellow: #FFD100;
        --uganda-red: #D90000;
        --uganda-primary: #0066cc;
        --uganda-primary-light: rgba(0, 102, 204, 0.1);
        --success-light: rgba(25, 135, 84, 0.1);
        --info-light: rgba(13, 202, 240, 0.1);
        --warning-light: rgba(255, 193, 7, 0.1);
        --danger-light: rgba(220, 53, 69, 0.1);
        --dark-light: rgba(33, 37, 41, 0.1);
        --purple: #6f42c1;
    }

    .text-uganda-primary {
        color: var(--uganda-primary) !important;
    }

    .text-uganda-yellow {
        color: var(--uganda-yellow) !important;
    }

    .text-uganda-red {
        color: var(--uganda-red) !important;
    }

    .text-uganda-black {
        color: var(--uganda-black) !important;
    }

    .bg-uganda-primary {
        background-color: var(--uganda-primary) !important;
    }

    .bg-uganda-yellow {
        background-color: var(--uganda-yellow) !important;
    }

    .bg-uganda-red {
        background-color: var(--uganda-red) !important;
    }

    .bg-uganda-primary-light {
        background-color: var(--uganda-primary-light) !important;
    }

    .bg-success-light {
        background-color: var(--success-light) !important;
    }

    .bg-info-light {
        background-color: var(--info-light) !important;
    }

    .bg-warning-light {
        background-color: var(--warning-light) !important;
    }

    .bg-danger-light {
        background-color: var(--danger-light) !important;
    }

    .bg-dark-light {
        background-color: var(--dark-light) !important;
    }

    .bg-purple {
        background-color: var(--purple) !important;
    }

    .btn-outline-uganda {
        color: var(--uganda-primary);
        border-color: var(--uganda-primary);
    }

    .btn-outline-uganda:hover {
        background-color: var(--uganda-primary);
        color: white;
    }

    /* Ministry Badge */
    .ministry-badge {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, var(--uganda-primary) 0%, #004080 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
    }

    /* User Avatar */
    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: var(--uganda-black);
    }

    /* Stats Cards */
    .stats-card {
        border-radius: 12px;
        transition: all 0.3s ease;
        border-left: 4px solid var(--uganda-primary);
    }

    .stats-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1) !important;
    }

    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    /* Action Icons */
    .action-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* System Status */
    .system-status-card {
        transition: all 0.3s ease;
    }

    .system-status-card:hover {
        background-color: rgba(0, 102, 204, 0.05);
        transform: translateX(5px);
    }

    .status-indicator {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    /* Chart Container */
    .chart-container {
        position: relative;
        width: 100%;
    }

    /* Animations */
    @@keyframes pulse {
        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }

        100% {
            opacity: 1;
        }
    }

    /* List Group Items */
    .list-group-item {
        border-left: none;
        border-right: none;
        transition: all 0.2s ease;
    }

    .list-group-item:first-child {
        border-top: none;
    }

    .list-group-item:last-child {
        border-bottom: none;
    }

    .list-group-item:hover {
        background-color: rgba(0, 102, 204, 0.05);
        border-left: 3px solid var(--uganda-primary);
        padding-left: 13px;
    }

    /* Badges */
    .badge {
        padding: 5px 10px;
        border-radius: 20px;
        font-weight: 500;
    }

    /* Alert Variants */
    .alert-danger-light {
        background-color: rgba(220, 53, 69, 0.1);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.2);
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script>
        (function () {
            // Ensure Bootstrap is loaded before initializing dropdowns
            function initializeBootstrapDropdowns() {
                // Method 1: Use Bootstrap's built-in initialization
                if (typeof bootstrap !== 'undefined' && bootstrap.Dropdown) {
                    // Initialize all dropdowns
                    var dropdownElements = document.querySelectorAll('[data-bs-toggle="dropdown"]');
                    dropdownElements.forEach(function (dropdownElement) {
                        try {
                            new bootstrap.Dropdown(dropdownElement);
                        } catch (e) {
                            console.warn('Failed to initialize dropdown:', e);
                        }
                    });
                } else {
                    // Method 2: Manual fallback if Bootstrap is not loaded
                    console.warn('Bootstrap not found, using manual dropdown implementation');
                    setupManualDropdowns();
                }
            }

            // Manual dropdown implementation as fallback
            function setupManualDropdowns() {
                document.querySelectorAll('.dropdown-toggle').forEach(function (toggle) {
                    toggle.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();

                        var dropdownMenu = this.nextElementSibling;
                        if (dropdownMenu && dropdownMenu.classList.contains('dropdown-menu')) {
                            var isVisible = dropdownMenu.style.display === 'block';

                            // Close all other dropdowns
                            document.querySelectorAll('.dropdown-menu').forEach(function (menu) {
                                menu.style.display = 'none';
                            });

                            // Toggle current dropdown
                            dropdownMenu.style.display = isVisible ? 'none' : 'block';
                        }
                    });
                });

                // Close dropdowns when clicking outside
                document.addEventListener('click', function (e) {
                    if (!e.target.closest('.dropdown')) {
                        document.querySelectorAll('.dropdown-menu').forEach(function (menu) {
                            menu.style.display = 'none';
                        });
                    }
                });
            }

            // Initialize charts
            function initializeCharts() {
                // Chart Data
                const docsByMonthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DocumentsByMonthLabels));
                const docsByMonthCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DocumentsByMonthCounts));
                const docsByTypeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DocumentsByTypeLabels));
                const docsByTypeCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DocumentsByTypeCounts));
                const staffByDeptLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StaffByDeptLabels));
                const staffByDeptCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StaffByDeptCounts));

                // Uganda Color Palette
                const ugandaColors = [
                    '#0066cc', // Primary Blue
                    '#FFD100', // Yellow
                    '#D90000', // Red
                    '#198754', // Success Green
                    '#6f42c1', // Purple
                    '#0dcaf0', // Info Cyan
                    '#ffc107', // Warning Yellow
                    '#20c997'  // Teal
                ];

                // Documents by Month Chart
                const monthlyCtx = document.getElementById('docsByMonthChart');
                if (monthlyCtx && docsByMonthLabels && docsByMonthCounts) {
                    try {
                        new Chart(monthlyCtx, {
                            type: 'line',
                            data: {
                                labels: docsByMonthLabels,
                                datasets: [{
                                    label: 'Documents',
                                    data: docsByMonthCounts,
                                    borderColor: '#0066cc',
                                    backgroundColor: 'rgba(0, 102, 204, 0.1)',
                                    borderWidth: 3,
                                    tension: 0.4,
                                    fill: true,
                                    pointBackgroundColor: '#0066cc',
                                    pointBorderColor: '#ffffff',
                                    pointBorderWidth: 2,
                                    pointRadius: 5,
                                    pointHoverRadius: 7
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false },
                                    tooltip: {
                                        mode: 'index',
                                        intersect: false,
                                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                        titleFont: { size: 14 },
                                        bodyFont: { size: 13 },
                                        padding: 12
                                    }
                                },
                                scales: {
                                    x: {
                                        grid: { display: false },
                                        ticks: { color: '#6c757d', font: { size: 12 } }
                                    },
                                    y: {
                                        beginAtZero: true,
                                        grid: { color: 'rgba(0, 0, 0, 0.05)' },
                                        ticks: { color: '#6c757d', font: { size: 12 } }
                                    }
                                },
                                interaction: {
                                    intersect: false,
                                    mode: 'nearest'
                                }
                            }
                        });
                    } catch (e) {
                        console.error('Error creating monthly chart:', e);
                    }
                }

                // Documents by Type Chart
                const typeCtx = document.getElementById('docsByTypeChart');
                if (typeCtx && docsByTypeLabels && docsByTypeCounts) {
                    try {
                        const chart = new Chart(typeCtx, {
                            type: 'doughnut',
                            data: {
                                labels: docsByTypeLabels,
                                datasets: [{
                                    data: docsByTypeCounts,
                                    backgroundColor: ugandaColors,
                                    borderWidth: 2,
                                    borderColor: '#ffffff'
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                cutout: '70%',
                                plugins: {
                                    legend: {
                                        display: false
                                    },
                                    tooltip: {
                                        callbacks: {
                                            label: function (context) {
                                                const label = context.label || '';
                                                const value = context.raw || 0;
                                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                                const percentage = Math.round((value / total) * 100);
                                                return `${label}: ${value} (${percentage}%)`;
                                            }
                                        }
                                    }
                                }
                            }
                        });

                        // Create custom legend
                        createCustomLegend(docsByTypeLabels, docsByTypeCounts, ugandaColors);
                    } catch (e) {
                        console.error('Error creating type chart:', e);
                    }
                }

                // Staff by Department Chart
                const staffCtx = document.getElementById('staffByDeptChart');
                if (staffCtx && staffByDeptLabels && staffByDeptCounts) {
                    try {
                        new Chart(staffCtx, {
                            type: 'bar',
                            data: {
                                labels: staffByDeptLabels,
                                datasets: [{
                                    label: 'Staff Count',
                                    data: staffByDeptCounts,
                                    backgroundColor: 'rgba(0, 102, 204, 0.8)',
                                    borderColor: '#0066cc',
                                    borderWidth: 1,
                                    borderRadius: 6,
                                    hoverBackgroundColor: 'rgba(0, 102, 204, 1)'
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false },
                                    tooltip: {
                                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                        padding: 10,
                                        cornerRadius: 6
                                    }
                                },
                                scales: {
                                    x: {
                                        grid: { display: false },
                                        ticks: {
                                            color: '#6c757d',
                                            font: { size: 11 },
                                            maxRotation: 45,
                                            minRotation: 0
                                        }
                                    },
                                    y: {
                                        beginAtZero: true,
                                        grid: { color: 'rgba(0, 0, 0, 0.05)' },
                                        ticks: {
                                            color: '#6c757d',
                                            font: { size: 11 },
                                            precision: 0
                                        }
                                    }
                                }
                            }
                        });
                    } catch (e) {
                        console.error('Error creating staff chart:', e);
                    }
                }
            }

            // Function to create custom legend for doughnut chart
            function createCustomLegend(labels, data, colors) {
                const legendContainer = document.querySelector('.legend-container');
                if (!legendContainer) return;

                let legendHTML = '<div class="legend-list">';
                const total = data.reduce((a, b) => a + b, 0);

                labels.forEach((label, index) => {
                    const value = data[index] || 0;
                    const percentage = total > 0 ? Math.round((value / total) * 100) : 0;

                    legendHTML += `
                                            <div class="d-flex align-items-center mb-2">
                                                <div class="legend-color me-2" style="width: 12px; height: 12px; background-color: ${colors[index % colors.length]}; border-radius: 2px;"></div>
                                                <div class="flex-grow-1">
                                                    <div class="d-flex justify-content-between">
                                                        <small class="text-muted">${label || 'Unknown'}</small>
                                                        <small class="fw-medium">${value}</small>
                                                    </div>
                                                    <div class="progress" style="height: 3px;">
                                                        <div class="progress-bar" style="width: ${percentage}%; background-color: ${colors[index % colors.length]};"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        `;
                });

                legendHTML += '</div>';
                legendContainer.innerHTML = legendHTML;
            }

            // Add smooth scrolling and animations
            function addAnimations() {
                document.addEventListener('DOMContentLoaded', function () {
                    // Add animation to stats cards on load
                    const statsCards = document.querySelectorAll('.stats-card');
                    statsCards.forEach((card, index) => {
                        card.style.animationDelay = `${index * 0.1}s`;
                        card.classList.add('animate__animated', 'animate__fadeInUp');
                    });
                });
            }

            // Wait for everything to load
            window.addEventListener('load', function () {
                // Initialize dropdowns first
                initializeBootstrapDropdowns();

                // Then initialize charts
                setTimeout(initializeCharts, 100);

                // Add animations
                addAnimations();
            });

            // Also run when DOM is ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function () {
                    initializeBootstrapDropdowns();
                    setTimeout(initializeCharts, 100);
                    addAnimations();
                });
            } else {
                initializeBootstrapDropdowns();
                setTimeout(initializeCharts, 100);
                addAnimations();
            }
        })();
    </script>
}