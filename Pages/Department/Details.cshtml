@page "{id}"
@model RegistryAPI.Pages.Department.DetailsModel
@{
    ViewData["Title"] = "Department Details";
}

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="row mb-4 pt-3">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <div class="ministry-badge">
                            <i class="fas fa-building"></i>
                        </div>
                    </div>
                    <div>
                        <h1 class="h3 fw-bold mb-1 text-uganda-primary">Department Details</h1>
                        <p class="text-muted mb-0">
                            Ministry of Works and Transport - Department Registry
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN LAYOUT -->
    <div class="row g-4">

        <!-- LEFT: DEPARTMENT DETAILS -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-info-circle text-uganda-primary me-2"></i>
                        Department Information
                    </h5>
                    <span class="badge bg-uganda-primary-light text-uganda-primary px-3 py-2">
                        ID: @Model.DepartmentItem.DeptId
                    </span>
                </div>

                <div class="card-body">
                    <div class="row g-4">

                        <div class="col-md-6">
                            <div class="detail-card p-3 border rounded h-100">
                                <i class="fas fa-id-card fa-2x text-uganda-primary mb-2"></i>
                                <div class="text-muted small">Department ID</div>
                                <div class="fw-bold fs-5">@Model.DepartmentItem.DeptId</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-card p-3 border rounded h-100">
                                <i class="fas fa-code fa-2x text-success mb-2"></i>
                                <div class="text-muted small">Department Code</div>
                                <div class="fw-bold fs-5">@Model.DepartmentItem.DeptCode</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="detail-card p-3 border rounded">
                                <i class="fas fa-signature fa-2x text-warning mb-2"></i>
                                <div class="text-muted small">Department Name</div>
                                <div class="fw-bold fs-4">@Model.DepartmentItem.DeptName</div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-4">
                            <div class="stat-card p-3 border rounded text-center">
                                <div class="fs-3 fw-bold text-uganda-primary">
                                    @Model.DepartmentStaff?.Count
                                </div>
                                <small class="text-muted">
                                    <i class="fas fa-users me-1"></i>Staff Members
                                </small>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- RIGHT: QUICK ACTIONS -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm sticky-top" style="top: 90px;">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-bolt text-uganda-yellow me-2"></i>
                        Quick Actions
                    </h5>
                </div>

                <div class="card-body">
                    <div class="d-grid gap-3">
                        <a asp-page="Index" class="btn btn-outline-dark btn-lg">
                            <i class="fas fa-arrow-left me-2"></i>
                            Back to List
                        </a>

                        <a asp-page="Edit" asp-route-id="@Model.DepartmentItem.DeptId"
                            class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-edit me-2"></i>
                            Edit Department
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- RELATED INFORMATION -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-link text-info me-2"></i>
                        Related Information
                    </h5>
                </div>

                <div class="card-body">
                    @if (Model.DepartmentStaff?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Staff ID</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Title</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.DepartmentStaff)
                                    {
                                        <tr>
                                            <td>@s.StaffId</td>
                                            <td>@($"{s.FirstName} {s.LastName}")</td>
                                            <td>@s.Email</td>
                                            <td>@s.Title</td>
                                            <td>@s.Status</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-users fa-3x mb-3"></i>
                            <h5>No staff assigned</h5>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>