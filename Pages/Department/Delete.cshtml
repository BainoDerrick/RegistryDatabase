@page "{id}"
@model RegistryAPI.Pages.Department.DeleteModel
@{
    ViewData["Title"] = "Delete Department";
}

<div class="container-fluid px-4">
    <!-- Minimal Header -->
    <div class="row mb-4 pt-3">
        <div class="col-12">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="ministry-badge bg-danger-light text-danger">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-danger">Delete Department</h1>
                    <p class="text-muted mb-0">Ministry of Works and Transport - Department Management</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Warning Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card border-danger border-2 shadow-sm">
                <div class="card-header bg-white border-bottom-0 py-3">
                    <h5 class="mb-0 fw-bold text-danger">
                        <i class="fas fa-trash-alt me-2"></i>Confirm Department Deletion
                    </h5>
                </div>

                <div class="card-body">
                    <!-- Warning Alert -->
                    <div class="alert alert-danger border-danger bg-danger-light border-0 mb-4">
                        <div class="d-flex">
                            <div class="me-3">
                                <i class="fas fa-exclamation-circle fa-2x"></i>
                            </div>
                            <div>
                                <h6 class="alert-heading fw-bold">Warning: This action cannot be undone!</h6>
                                <p class="mb-0">Deleting this department will permanently remove it from the system. All
                                    associated data will be affected.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Department Details -->
                    <div class="department-details-card border rounded p-4 mb-4">
                        <h6 class="fw-bold text-uganda-primary mb-3">
                            <i class="fas fa-building me-2"></i>Department Information
                        </h6>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <div class="detail-label text-muted small">Department ID</div>
                                    <div class="detail-value fw-bold text-dark">
                                        <i class="fas fa-id-card text-uganda-primary me-2"></i>
                                        @Model.DepartmentItem.DeptId
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="detail-item">
                                    <div class="detail-label text-muted small">Department Code</div>
                                    <div class="detail-value fw-bold text-dark">
                                        <i class="fas fa-code text-uganda-primary me-2"></i>
                                        @Model.DepartmentItem.DeptCode
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Additional Information if available -->
                        @if (!string.IsNullOrEmpty(Model.DepartmentItem.DeptName))
                        {
                            <div class="detail-item mt-3">
                                <div class="detail-label text-muted small">Department Name</div>
                                <div class="detail-value fw-bold text-dark">
                                    <i class="fas fa-signature text-uganda-primary me-2"></i>
                                    @Model.DepartmentItem.DeptName
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Impact Assessment -->
                    <div class="alert alert-warning border-warning bg-warning-light border-0 mb-4">
                        <h6 class="fw-bold mb-2">
                            <i class="fas fa-exclamation-triangle me-2"></i>Potential Impact
                        </h6>
                        <ul class="mb-0 ps-3">
                            <li>All staff assigned to this department will need reassignment</li>
                            <li>Documents associated with this department will lose their department reference</li>
                            <li>Historical records referencing this department will show as "Deleted Department"</li>
                        </ul>
                    </div>

                    <!-- Confirmation Form -->
                    <form method="post" id="deleteForm">
                        <input type="hidden" asp-for="DepartmentItem.DeptId" />

                        <!-- Confirmation Checkbox -->
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                            <label class="form-check-label fw-medium" for="confirmDelete">
                                I understand that this action is permanent and cannot be undone
                            </label>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger btn-lg px-4 flex-grow-1" id="deleteBtn"
                                disabled>
                                <i class="fas fa-trash-alt me-2"></i>Delete Department Permanently
                            </button>
                            <a asp-page="Index" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

