@page
@model RegistryAPI.Pages.Department.CreateModel
@{
    ViewData["Title"] = "Create Department";

    var userName = User.Identity?.Name;
    var firstName = "User";

    if (!string.IsNullOrEmpty(userName) && userName.Contains('@'))
    {
        firstName = userName.Split('@')[0];
        firstName = System.Globalization.CultureInfo.CurrentCulture.TextInfo
        .ToTitleCase(firstName.ToLower());
    }
    else if (!string.IsNullOrEmpty(userName))
    {
        firstName = userName;
    }
}

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="row align-items-center mb-4 pt-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="ministry-badge">
                        <i class="fas fa-building"></i>
                    </div>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-uganda-primary">
                        Create New Department
                    </h1>
                    <p class="text-muted mb-0">
                        Ministry of Works and Transport - Department Registry
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- FULL WIDTH FORM -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-plus-circle text-success me-2"></i>
                        Department Information
                    </h5>
                </div>

                <div class="card-body">
                    <form method="post" id="departmentForm">

                        <div class="row g-4">
                            <!-- Department ID -->
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Department ID</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-id-card"></i>
                                    </span>
                                    <input asp-for="Department.DeptId" class="form-control form-control-lg"
                                        placeholder="Enter unique department ID" />
                                </div>
                                <span asp-validation-for="Department.DeptId" class="text-danger small"></span>
                            </div>

                            <!-- Department Code -->
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Department Code</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-code"></i>
                                    </span>
                                    <input asp-for="Department.DeptCode" class="form-control form-control-lg"
                                        placeholder="AA OR MS" />
                                </div>
                                <span asp-validation-for="Department.DeptCode" class="text-danger small"></span>
                            </div>

                            <!-- Department Name (FULL WIDTH) -->
                            <div class="col-12">
                                <label class="form-label fw-medium">Department Name</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-building"></i>
                                    </span>
                                    <input asp-for="Department.DeptName" class="form-control form-control-lg"
                                        placeholder="Enter full department name" />
                                </div>
                                <span asp-validation-for="Department.DeptName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-3 mt-4 pt-4 border-top">
                            <button type="submit" class="btn btn-uganda-primary btn-lg px-5">
                                <i class="fas fa-save me-2"></i>Create Department
                            </button>

                            <a asp-page="Index" class="btn btn-outline-secondary btn-lg px-5">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Styles moved to ~/css/pages.css (consolidated) -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}