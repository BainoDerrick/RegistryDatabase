@page
@model RegistryAPI.Pages.Document.CreateModel
@{
    ViewData["Title"] = "Create Document";

    var userName = User.Identity?.Name;
    var firstName = "User";

    if (!string.IsNullOrEmpty(userName) && userName.Contains('@'))
    {
        firstName = userName.Split('@')[0];
        firstName = System.Globalization.CultureInfo.CurrentCulture.TextInfo
        .ToTitleCase(firstName.ToLower());
    }
    else if (!string.IsNullOrEmpty(userName))
    {
        firstName = userName;
    }
}

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="row align-items-center mb-4 pt-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="ministry-badge">
                        <i class="fas fa-file-alt"></i>
                    </div>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-uganda-primary">
                        Create New Document
                    </h1>
                    <p class="text-muted mb-0">
                        Ministry of Works and Transport - Document Registry
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- FULL WIDTH FORM -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-plus-circle text-success me-2"></i>
                        Document Information
                    </h5>
                </div>

                <div class="card-body">
                    <form method="post" enctype="multipart/form-data" id="documentForm">

                        <div class="row g-4">
                            <!-- Document Name (FULL WIDTH) -->
                            <div class="col-12">
                                <label class="form-label fw-medium">Document Name</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-file-signature"></i>
                                    </span>
                                    <input asp-for="Document.DocumentName" class="form-control form-control-lg"
                                        placeholder="Enter document name" />
                                </div>
                                <span asp-validation-for="Document.DocumentName" class="text-danger small"></span>
                            </div>

                            <!-- Existing File Selection -->
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Associate Existing File (Optional)</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-folder-open"></i>
                                    </span>
                                    <select asp-for="Document.FileId" class="form-select form-select-lg"
                                        asp-items="@(ViewData["FileOptions"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
                                        <option value="">-- Select existing file --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Document.FileId" class="text-danger small"></span>
                            </div>

                            <!-- Document Type -->
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Document Type</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-tag"></i>
                                    </span>
                                    <select asp-for="Document.DocTypeId" class="form-select form-select-lg"
                                        asp-items="@(ViewData["DocumentTypeOptions"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
                                        <option value="">-- Select document type --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Document.DocTypeId" class="text-danger small"></span>
                            </div>

                            <!-- Document Date -->
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Document Date</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-calendar-alt"></i>
                                    </span>
                                    <input asp-for="Document.DocumentDate" type="date"
                                        class="form-control form-control-lg" />
                                </div>
                                <span asp-validation-for="Document.DocumentDate" class="text-danger small"></span>
                            </div>

                            <!-- Upload New File -->
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Upload New File (Optional)</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-upload"></i>
                                    </span>
                                    <input asp-for="Upload" type="file" class="form-control form-control-lg"
                                        id="Upload" data-max-bytes="@Model.MaxUploadBytes" data-max-mb="@Model.MaxUploadMB" />
                                </div>
                                <div class="form-text">Supported formats: PDF, DOCX, etc. Maximum upload:
                                    @Model.MaxUploadMB MB.</div>
                                <span asp-validation-for="Upload" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-3 mt-4 pt-4 border-top">
                            <button type="submit" class="btn btn-uganda-primary btn-lg px-5">
                                <i class="fas fa-save me-2"></i>Create Document
                            </button>

                            <a asp-page="Index" class="btn btn-outline-secondary btn-lg px-5">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --uganda-primary: #0066cc;
        --uganda-primary-light: rgba(0, 102, 204, .1);
        --uganda-yellow: #FFD100;
    }

    .ministry-badge {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, var(--uganda-primary), #004080);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
    }

    .input-group-text {
        background-color: var(--uganda-primary-light);
        color: var(--uganda-primary);
    }

    .btn-uganda-primary {
        background-color: var(--uganda-primary);
        color: #fff;
        border: none;
    }

    .btn-uganda-primary:hover {
        background-color: #0052a3;
    }

    .form-control-lg,
    .form-select-lg {
        width: 100%;
    }

<!-- Styles moved to ~/css/pages.css (consolidated) -->

<!-- Upload validation moved to ~/js/pages.js (reads data attributes on #Upload) -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}