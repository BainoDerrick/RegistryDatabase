@page "{id:int}"
@model RegistryAPI.Pages.Document.DetailsModel
@{
    ViewData["Title"] = "Document Details";

    var userName = User.Identity?.Name;
    var firstName = "User";

    if (!string.IsNullOrEmpty(userName) && userName.Contains('@'))
    {
        firstName = userName.Split('@')[0];
        firstName = System.Globalization.CultureInfo.CurrentCulture.TextInfo
        .ToTitleCase(firstName.ToLower());
    }
    else if (!string.IsNullOrEmpty(userName))
    {
        firstName = userName;
    }
}

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="row align-items-center mb-4 pt-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="ministry-badge">
                        <i class="fas fa-file-alt"></i>
                    </div>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-uganda-primary">
                        Document Details
                    </h1>
                    <p class="text-muted mb-0">
                        Ministry of Works and Transport - Document Registry
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- DETAILS CARD -->
    <div class="row">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-info-circle text-uganda-primary me-2"></i>
                        Document Information
                    </h5>
                </div>

                <div class="card-body">
                    <div class="bg-light rounded p-4">

                        <div class="row g-4">

                            <!-- Document ID -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <div class="text-muted small fw-medium">Document ID</div>
                                    <div class="fw-bold fs-4">
                                        <i class="fas fa-id-badge text-uganda-primary me-2"></i>
                                        @Model.DocumentItem.DocumentId
                                    </div>
                                </div>
                            </div>

                            <!-- Document Name -->
                            <div class="col-12">
                                <div class="detail-item">
                                    <div class="text-muted small fw-medium">Document Name</div>
                                    <div class="fw-bold fs-4">
                                        <i class="fas fa-file-signature text-uganda-primary me-2"></i>
                                        @Model.DocumentItem.DocumentName
                                    </div>
                                </div>
                            </div>

                            <!-- Associated File -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <div class="text-muted small fw-medium">Associated File</div>
                                    <div class="fw-bold fs-5">
                                        <i class="fas fa-paperclip text-uganda-primary me-2"></i>
                                        @(Model.DocumentItem.FileId.HasValue
                                                                                ? $"File ID: {Model.DocumentItem.FileId.Value}"
                                                                                : "No file attached")
                                    </div>
                                </div>
                            </div>

                            <!-- Document Type -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <div class="text-muted small fw-medium">Document Type</div>
                                    <div class="fw-bold fs-5">
                                        <i class="fas fa-tag text-uganda-primary me-2"></i>
                                        @(Model.DocumentItem.DocumentType?.TypeName ?? "Not specified")
                                    </div>
                                </div>
                            </div>

                            <!-- Document Date -->
                            @if (Model.DocumentItem.DocumentDate.HasValue)
                            {
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="text-muted small fw-medium">Document Date</div>
                                        <div class="fw-bold fs-5">
                                            <i class="fas fa-calendar-alt text-uganda-primary me-2"></i>
                                            @Model.DocumentItem.DocumentDate.Value.ToString("dd MMMM yyyy")
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-3 mt-4 pt-4 border-top">
                        <a asp-page="Edit" asp-route-id="@Model.DocumentItem.DocumentId"
                            class="btn btn-warning btn-lg px-5">
                            <i class="fas fa-edit me-2"></i>Edit Document
                        </a>

                        <a asp-page="Index" class="btn btn-outline-secondary btn-lg px-5">
                            <i class="fas fa-list me-2"></i>Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Styles moved to ~/css/pages.css (consolidated) -->