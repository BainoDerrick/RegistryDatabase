@page "{id:int}"
@model RegistryAPI.Pages.Document.DeleteModel
@{
    ViewData["Title"] = "Delete Document";

    var userName = User.Identity?.Name;
    var firstName = "User";

    if (!string.IsNullOrEmpty(userName) && userName.Contains('@'))
    {
        firstName = userName.Split('@')[0];
        firstName = System.Globalization.CultureInfo.CurrentCulture.TextInfo
        .ToTitleCase(firstName.ToLower());
    }
    else if (!string.IsNullOrEmpty(userName))
    {
        firstName = userName;
    }
}

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="row align-items-center mb-4 pt-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="ministry-badge">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-danger">
                        Delete Document
                    </h1>
                    <p class="text-muted mb-0">
                        Ministry of Works and Transport - Document Registry
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- CENTERED CARD -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm border-danger border-2">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold text-danger">
                        <i class="fas fa-trash-alt text-danger me-2"></i>
                        Confirm Document Deletion
                    </h5>
                </div>

                <div class="card-body">

                    <!-- Main Warning Alert -->
                    <div class="alert alert-danger bg-danger-light border-0 mb-4">
                        <div class="d-flex align-items-start">
                            <div class="me-3 flex-shrink-0">
                                <i class="fas fa-exclamation-circle fa-2x"></i>
                            </div>
                            <div>
                                <h6 class="alert-heading fw-bold mb-2">Warning: This action cannot be undone!</h6>
                                <p class="mb-0">Deleting this document will permanently remove it from the registry.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Document Details -->
                    <div class="bg-light rounded p-4 mb-4">
                        <h6 class="fw-bold text-uganda-primary mb-3">
                            <i class="fas fa-file-alt me-2"></i>Document to be Deleted
                        </h6>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <div class="text-muted small fw-medium">Document ID</div>
                                    <div class="fw-bold fs-5">
                                        <i class="fas fa-id-badge text-uganda-primary me-2"></i>
                                        @Model.DocumentItem.DocumentId
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.DocumentItem.DocumentName))
                            {
                                <div class="col-12">
                                    <div class="detail-item">
                                        <div class="text-muted small fw-medium">Document Name</div>
                                        <div class="fw-bold fs-5">
                                            <i class="fas fa-file-signature text-uganda-primary me-2"></i>
                                            @Model.DocumentItem.DocumentName
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (Model.DocumentItem.DocumentDate.HasValue)
                            {
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="text-muted small fw-medium">Document Date</div>
                                        <div class="fw-bold fs-5">
                                            <i class="fas fa-calendar-alt text-uganda-primary me-2"></i>
                                            @Model.DocumentItem.DocumentDate.Value.ToString("dd MMMM yyyy")
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (Model.DocumentItem.DocTypeId.HasValue)
                            {
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="text-muted small fw-medium">Document Type</div>
                                        <div class="fw-bold fs-5">
                                            <i class="fas fa-tag text-uganda-primary me-2"></i>
                                            Not specified
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Impact Warning -->
                    <div class="alert alert-warning bg-warning-light border-0 mb-4">
                        <h6 class="fw-bold mb-2">
                            <i class="fas fa-exclamation-triangle me-2"></i>Potential Impact
                        </h6>
                        <ul class="mb-0 ps-3 small">
                            <li>The physical file will be permanently removed from storage</li>
                            <li>Any references to this document in reports or records will be broken</li>
                            <li>Audit logs will record the deletion but the document cannot be recovered</li>
                        </ul>
                    </div>

                    <!-- Confirmation Form -->
                    <form method="post" id="deleteForm">
                        <input type="hidden" asp-for="DocumentItem.DocumentId" />

                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                            <label class="form-check-label fw-medium" for="confirmDelete">
                                I understand that this action is permanent and cannot be undone
                            </label>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-3 mt-4 pt-4 border-top">
                            <button type="submit" class="btn btn-danger btn-lg px-5 flex-fill" id="deleteBtn" disabled>
                                <i class="fas fa-trash-alt me-2"></i>Delete Permanently
                            </button>

                            <a asp-page="Index" class="btn btn-outline-secondary btn-lg px-5">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --uganda-primary: #0066cc;
        --uganda-primary-light: rgba(0, 102, 204, .1);
        --uganda-yellow: #FFD100;
        --danger-light: rgba(220, 53, 69, 0.1);
        --warning-light: rgba(255, 193, 7, 0.1);
    }

    .ministry-badge {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #dc3545, #c82333);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
    }

    .bg-danger-light {
        background-color: var(--danger-light);
    }

    .bg-warning-light {
        background-color: var(--warning-light);
    }

    .text-uganda-primary {
        color: var(--uganda-primary);
    }

    .btn-danger {
        background-color: #dc3545;
        border: none;
    }

    .btn-danger:hover {
        background-color: #c82333;
    }

    .btn-danger:disabled {
        background-color: rgba(220, 53, 69, 0.4);
        cursor: not-allowed;
    }

    .form-check-input:checked {
        background-color: var(--uganda-primary);
        border-color: var(--uganda-primary);
    }

    .form-check-input:focus {
        box-shadow: 0 0 0 0.25rem rgba(0, 102, 204, 0.25);
    }

    .alert {
        border-radius: 0.5rem;
    }
</style>

